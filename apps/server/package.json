{
  "name": "@radar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@radar/contracts": "*",
    "cheerio": "^1.2.0",
    "hono": "^4.0.0",
    "openai": "^7.5.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0"
  }
}
