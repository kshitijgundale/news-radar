{
  "expo": {
    "name": "Radar",
    "slug": "radar",
    "scheme": "radar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true },
    "android": { "adaptiveIcon": { "backgroundColor": "#0b1220" } },
    "web": { "bundler": "metro", "output": "single" }
  }
}
