# Backend-only. Never expose these through EXPO_PUBLIC_* variables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/radar
SEARCH_API_KEY=replace-me
LLM_API_KEY=replace-me
SCHEDULER_SECRET=replace-with-at-least-24-characters
SEARCH_MODEL=web-search-model
LLM_MODEL=structured-reasoning-model
PORT=3000
MAX_SOURCE_CONTENT_BYTES=500000
# Comma-separated deployed web origins. Localhost origins are allowed automatically in development.
CORS_ORIGINS=

# Safe to embed in the Expo bundle.
EXPO_PUBLIC_API_URL=http://localhost:3000
